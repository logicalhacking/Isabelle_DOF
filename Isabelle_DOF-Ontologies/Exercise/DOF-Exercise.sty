\NeedsTeXFormat{LaTeX2e}\relax
\ProvidesPackage{DOF-Exercise}
  [2026/01/01 Representation of the DOF ontology Exercise (an abstraction of exercise.sty).]

\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{DOF-COL}   % the Exercise ontology is based on the COL
% Counters, headers, names and their translations (\ExerciseName, \AnswerName, \ExePartName), the
% difficulty marker and the list of exercises are those of exercise.sty (see below).
\RequirePackage{exercise}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The selection concept: the role of the document is the name of the document variant
% (see the Isabelle option document_variants): student, professor or examiner. Every element
% has an audience, the lowest role that sees it. Other variant names (such as the default
% "document") are treated as the examiner, who sees everything.
\newif\ifDOFexe@bannershown
\def\DOFexe@lvl@student{0}
\def\DOFexe@lvl@professor{1}
\def\DOFexe@lvl@examiner{2}
% \DOFexeSetRole{<role>} sets the role of the document. It is called by the command exercise_role
% of the theory; without it, the name of the document variant is used.
\newcommand\DOFexeSetRole[1]{\global\DOFexe@bannershownfalse\edef\DOFexe@r{#1}%
  \ifdefstring{\DOFexe@r}{student}{%
    \def\DOFexe@role{0}\def\DOFexeRole{Student version}}{%
  \ifdefstring{\DOFexe@r}{professor}{%
    \def\DOFexe@role{1}\def\DOFexeRole{Professor version (with solutions)}}{%
    \def\DOFexe@role{2}\def\DOFexeRole{Examiner version (with solutions and remarks)}}}}
\DOFexeSetRole{\dof@docvariant}

% \DOFexeSetSheet{category}{course}{institution}{year}, called by the command exercise_role
% with the data of the open exercise sheet
\def\DOFexe@sheet{}
\newcommand\DOFexe@categoryname[1]{%
  \ifstrequal{#1}{TD}{Tutorial (TD)}{%
  \ifstrequal{#1}{TP}{Practical work (TP)}{%
  \ifstrequal{#1}{CM}{Lecture (CM)}{%
  \ifstrequal{#1}{Exam}{Exam}{#1}}}}}
\newcommand\DOFexeSetSheet[4]{%
  \xdef\DOFexe@sa{#1}\xdef\DOFexe@sb{#2}\xdef\DOFexe@sc{#3}\xdef\DOFexe@sd{#4}%
  \gdef\DOFexe@sheet{\DOFexe@categoryname{\DOFexe@sa}%
    \ifdefempty{\DOFexe@sb}{}{ --- \DOFexe@sb}%
    \ifdefempty{\DOFexe@sc}{}{, \DOFexe@sc}%
    \ifnum\DOFexe@sd>0 , \DOFexe@sd\fi}}

% \DOFexe@ifvisible{<audience>}{<code>} executes <code> if the role sees the audience. The text of
% elements that are not visible is never typeset, so it cannot appear in the document.
\newcommand\DOFexe@ifvisible[2]{%
  \ifnum\DOFexe@role<\csname DOFexe@lvl@#1\endcsname\relax\else#2\fi}

% The banner shows the data of the sheet and the role. It is shown once: by the command exercise_role,
% or else by the first exercise.
\newcommand\DOFexeShowBanner{\ifDOFexe@bannershown\else
  \par\medskip{\centering\large\color{gray}%
    \ifdefempty{\DOFexe@sheet}{}{\DOFexe@sheet\par}\DOFexeRole\par}\medskip
  \global\DOFexe@bannershowntrue\fi}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Numbering, headers and layout are those of exercise.sty: its counters (Exercise, ExePart, Question,
% subQuestion, which reset each other as sections and subsections do), its keys and flags, its header
% commands (\ExerciseHeader, \ExePartListHeader, \QuestionNB, ...), its difficulty marker, its lengths
% and its list of exercises. What is replaced is only the machinery of nested list environments: a
% command of exercise.sty opens a list that is closed by a later command, which does not survive the
% groups of the elements (every text* is an environment of its own). Here, the levels of the questions
% are flat paragraphs with a hanging indentation, numbered by the counters of exercise.sty.
\def\DifficultyMarker{\ensuremath{\star}}
% the name of the solutions (the \AnswerName of exercise.sty is "Answer of exercise")
\providecommand\DOFexeSolutionName{Solution}
% the value of an attribute is expanded before it is tested
\newcommand\DOFexe@ifempty[3]{\edef\DOFexe@tmp{#1}\ifdefempty{\DOFexe@tmp}{#2}{#3}}
% the points are shown if they are not the default (0)
\newcommand\DOFexe@points[1]{\ifnum#1>0 \hfill\textit{(#1 pts)}\fi}
% an indentation of the blocks of solutions and remarks
\newlength\DOFexe@indent\setlength\DOFexe@indent{\QuestionIndent}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% exercise: Exercise (exercise.sty)
\newisadof{ExerciseDOTexercise}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
 ,ExerciseDOTexerciseDOTorigin=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \DOFexeShowBanner
    \@InitExe
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTtitle}}{}{%
      \xdef\ExerciseTitle{\DOFexe@tmp}\global\@ExeTitletrue}%
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseDOTorigin}}{}{%
      \xdef\ExerciseOrigin{\DOFexe@tmp}\global\@ExeOrigintrue}%
    \ifnum\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}>0
      \global\ExerciseDifficulty=\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}%
      \global\@ExeDifficultytrue\fi
    \par\pagebreak[1]\vskip\ExerciseSkipBefore
    \refstepcounter{Exercise}\label{\commandkey{label}}%
    \begingroup\@getExerciseInfo\ExerciseHeader
      \addcontentsline{\ext@exercise}{\toc@exercise}{\ExerciseName\ \theExercise\
        \expandafter{\itshape \ExerciseTitle}\hspace{.66em}}\endgroup
    \AtBeginExercise
    \noindent #1\par}%
}

% exercise_part: ExePart (exercise.sty)
\newisadof{ExerciseDOTexerciseUNDERSCOREpart}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
 ,ExerciseDOTexerciseUNDERSCOREpartDOTname=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \@InitExePart
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTtitle}}{}{%
      \xdef\ExePartTitle{\DOFexe@tmp}\global\@ExePartTitletrue}%
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREpartDOTname}}{}{%
      \xdef\@ExePartName{\DOFexe@tmp}\global\@ExePartReNametrue}%
    \ifnum\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}>0
      \global\ExePartDifficulty=\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}%
      \global\@ExePartDifficultytrue\fi
    \par\refstepcounter{ExePart}\label{\commandkey{label}}%
    \begingroup\@getExePartInfo\ExePartListHeader\endgroup
    \noindent #1\par}%
}

% task: Question (exercise.sty)
\newisadof{ExerciseDOTtask}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
 ,ExerciseDOTtaskDOTpoints=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \@InitQuestion
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTtitle}}{}{%
      \xdef\QuestionTitle{\DOFexe@tmp}\global\@QuestionTitletrue}%
    \ifnum\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}>0
      \global\QuestionDifficulty=\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}%
      \global\@QuestionDifficultytrue\fi
    \par\vskip\QuestionBefore\refstepcounter{Question}\label{\commandkey{label}}%
    \noindent\hangindent\QuestionIndent\hangafter=1
    \begingroup\@getQuestionInfo
      \makebox[\QuestionIndent][l]{\QuestionHeaderDifficulty\QuestionNB}%
      \QuestionHeaderTitle\endgroup
    #1%
    \DOFexe@points{\commandkey{ExerciseDOTtaskDOTpoints}}\par}%
}

% subtask: subQuestion (exercise.sty)
\newisadof{ExerciseDOTsubtask}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
 ,ExerciseDOTsubtaskDOTpoints=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \@InitsubQuestion
    \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTtitle}}{}{%
      \xdef\subQuestionTitle{\DOFexe@tmp}\global\@subQuestionTitletrue}%
    \ifnum\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}>0
      \global\subQuestionDifficulty=\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty}%
      \global\@subQuestionDifficultytrue\fi
    \par\vskip\subQuestionBefore\refstepcounter{subQuestion}\label{\commandkey{label}}%
    \noindent\hangindent=\dimexpr\QuestionIndent+\subQuestionIndent\relax\hangafter=1
    \hspace*{\QuestionIndent}%
    \begingroup\@getsubQuestionInfo
      \makebox[\subQuestionIndent][l]{\subQuestionHeaderDifficulty\subQuestionNB}%
      \subQuestionHeaderTitle\endgroup
    #1%
    \DOFexe@points{\commandkey{ExerciseDOTsubtaskDOTpoints}}\par}%
}

% solution: Answer (exercise.sty). The audience is the last value of the attribute visible_to: the default
% of the class (professor) overrides the one of the superclass.
\newisadof{ExerciseDOTsolution}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
 ,ExerciseDOTsolutionDOTrefersUNDERSCOREto=%
 ,ExerciseDOTsolutionDOTalsoUNDERSCORErefersUNDERSCOREto=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \par\vskip\AnswerSkipBefore\noindent\hangindent=\DOFexe@indent\hangafter=0
    \hspace*{\DOFexe@indent}{\color{blue!50!black}\textbf{\DOFexeSolutionName:}\ #1}\par\vskip\AnswerSkipAfter}%
}

% remark: no equivalent in exercise.sty; for the external evaluators
\newisadof{ExerciseDOTremark}%
[label=,type=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTlevel=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTreferentiable=%
 ,IsaUNDERSCORECOLDOTtextUNDERSCOREelementDOTvariants=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTtitle=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTdifficulty=%
 ,ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto=%
][1]{%
  \DOFexe@ifvisible{\commandkey{ExerciseDOTexerciseUNDERSCOREelementDOTvisibleUNDERSCOREto}}{%
    \par\smallskip\noindent\hangindent=\DOFexe@indent\hangafter=0
    \hspace*{\DOFexe@indent}{\small\color{red!60!black}\textsf{Remark:}\ #1}\par}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% exercise_sheet, declared as text element: the body is the title of the document (it replaces
% title*), the attributes give the optional subtitle and the data shown in the banner.
% Like for title*, the title is passed to the next run of LaTeX by the auxiliary file.
\newisadof{ExerciseDOTexerciseUNDERSCOREsheet}%
[label=,type=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTcategory=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTsubtitle=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTcourse=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTyear=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTtrace=%
 ,ExerciseDOTexerciseUNDERSCOREsheetDOTinstitution=%
][1]{%
  \immediate\write\@auxout{\noexpand\title{#1}}%
  \DOFexe@ifempty{\commandkey{ExerciseDOTexerciseUNDERSCOREsheetDOTsubtitle}}{}{%
    \immediate\write\@auxout{\noexpand\subtitle{\DOFexe@tmp}}}%
  \DOFexeSetSheet{\commandkey{ExerciseDOTexerciseUNDERSCOREsheetDOTcategory}}%
                 {\commandkey{ExerciseDOTexerciseUNDERSCOREsheetDOTcourse}}%
                 {\commandkey{ExerciseDOTexerciseUNDERSCOREsheetDOTinstitution}}%
                 {\commandkey{ExerciseDOTexerciseUNDERSCOREsheetDOTyear}}%
}
