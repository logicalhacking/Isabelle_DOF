\NeedsTeXFormat{LaTeX2e}\relax
\ProvidesPackage{DOF-gridtbl}
  [2026/01/01 Support for grid tables (gridtbl) of the Isabelle/DOF COL.]

\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{hhline}

% width of a cell spanning columns of logical width #1 (out of #2 in total) in a table with #3
% columns (#4 = #3+1 vertical rules) where #5 = (number of spanned columns) - 1
\newcommand{\DOFgridcellw}[5]{%
  \dimexpr(\linewidth-(2\tabcolsep)*#3-\arrayrulewidth*#4)*#1/#2+(2\tabcolsep+\arrayrulewidth)*#5\relax}

% #1: width, #2: alignment command, #3: number of rows, #4: text
\newcommand{\DOFgridcell}[4]{%
  \ifnum#3>1
    \multirow{#3}{*}{\parbox[c]{#1}{#2 #4\strut}}%
  \else
    \parbox[t]{#1}{#2 #4\strut}%
  \fi}

% display of the control symbol \<^gridtbl> in the text (\<^gridtbl>\<open>...\<close>)
\providecommand{\isactrlgridtbl}{{\ttfamily\char`\\<\char`\^gridtbl>}}

% bold (thick) borders of grid tables: the thickness, and the normal rule width to be restored
\newlength{\DOFgridthick}\setlength{\DOFgridthick}{1.2pt}
\newlength{\DOFgridthin}\AtBeginDocument{\setlength{\DOFgridthin}{\arrayrulewidth}}

% Presentation of the source of a grid table (as in the editor): in a box of the manual, fixed-pitch,
% where every symbol occupies one column of the same width
\newcommand{\DOFgo}{\guilsinglleft}
\newcommand{\DOFgc}{\guilsinglright}
\newcommand{\DOFgcaret}{\char94 }
\newcommand{\DOFgsym}{\char63 }
\newcommand{\DOFgbar}{\hbox to \fontcharwd\font`a{\hss\vrule width 0.14em height 1.05ex depth 0.35ex\hss}}
\newcommand{\DOFgridline}[1]{\noindent\hbox{#1}\par}
\newenvironment{DOFgridsrc}%
  {\begin{isarbox}\ttfamily\footnotesize\color[HTML]{B35A00}\parindent0pt\parskip0pt\raggedright}%
  {\end{isarbox}}

% name of a command around the grid table in its presentation (as in the editor)
\newcommand{\DOFgridcmd}[1]{{\itshape\color[HTML]{4A3B2A}#1}}
